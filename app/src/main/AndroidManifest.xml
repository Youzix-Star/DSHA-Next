<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网页页签要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      `usesCleartextTraffic` is on because this app exists to reach services running on the phone
      itself (the terminal bridge answers on loopback), and Android blocks cleartext by default
      from API 28 on.
    -->
    <application
        android:name=".DshaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DshaNext">

        <!--
          The crash report screen. `:crash` matters: the main process is dying when this opens, and
          the report has to outlive it. It draws itself with plain views and no theme resources, so
          it cannot fail the way the app just did.
        -->
        <activity
            android:name=".ui.crash.CrashReportActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.DshaNext">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
