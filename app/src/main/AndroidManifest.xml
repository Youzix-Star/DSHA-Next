<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网页页签要联网 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Termux 的 RUN_COMMAND 服务由它自己声明的这条权限守着（protectionLevel="dangerous"）。
      首页的安装/启动/停止就是发这条指令；没有它，Termux 会直接拒绝，连结果都不会回。
      这是「向另一个应用申请权限」：Termux 装着才解析得到，所以装 Termux 之前这台设备上
      不会有人来要这个权限。授权入口在 Termux 的应用信息页里（见 TermuxBridge.permissionIntent）。
    -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
      Android 11 起的包可见性：不声明就看不到 Termux，isInstalled() 会一直返回 false。
      只查这一个包名，不申请 QUERY_ALL_PACKAGES。
    -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <!--
      `usesCleartextTraffic` is on because this app exists to reach services running on the phone
      itself (the terminal bridge answers on loopback), and Android blocks cleartext by default
      from API 28 on.
    -->
    <application
        android:name=".DshaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DshaNext">

        <!--
          The crash report screen. `:crash` matters: the main process is dying when this opens, and
          the report has to outlive it. It draws itself with plain views and no theme resources, so
          it cannot fail the way the app just did.
        -->
        <activity
            android:name=".ui.crash.CrashReportActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!--
          adjustNothing: the window is never resized or panned for the keyboard, so the layout
          cannot be pushed around by it — the floating bottom bar in particular has to stay on the
          bottom edge. Everything this app types into so far is at the top of its page; when a
          bottom-anchored input shows up, pad that screen with Modifier.imePadding() instead of
          letting the system move the window.
        -->

        <!--
          Termux 把 RUN_COMMAND 的执行结果投递到这里。用清单声明的接收器而不是运行时注册：
          命令可能在 Activity 已经不在的时候才回（长时间安装、旋转、切去 Termux 再回来），
          运行时注册的接收器会跟着 Activity 一起注销，回包就落空了。

          exported="false"：投递方的 PendingIntent 指名了这个类，只有持有那个一次性
          PendingIntent 的 Termux 能送到，别的应用无法伪造结果广播。
        -->
        <receiver
            android:name=".termux.TermuxResultReceiver"
            android:exported="false" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.DshaNext">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
